# Copy this file to .env and fill in real values. Never commit .env itself.

# --- Postgres ---
POSTGRES_DB=privacy_inspector
POSTGRES_USER=dev
POSTGRES_PASSWORD=dev
DATABASE_URL=postgresql://dev:dev@db:5432/privacy_inspector

# --- FastAPI ---
API_HOST=0.0.0.0
API_PORT=8000
ENV=development

# --- ML models ---
# Path or HF hub id for the fine-tuned category filter / attribute extractor
CATEGORY_MODEL_PATH=
ATTRIBUTE_MODEL_PATH=

# --- Cookie classification ---
# Local path to Open Cookie Database (or wherever Person 2 lands it)
OPEN_COOKIE_DB_PATH=
